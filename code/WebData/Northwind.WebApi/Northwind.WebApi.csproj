<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InterceptorsNamespaces>
      $(InterceptorsNamespaces);Microsoft.AspNetCore.Http.Validation.Generated
    </InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup Label="Package reference versions are set at the solution level.">
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
	</ItemGroup>

  <ItemGroup Label="To simplify use of Console members.">
    <Using Include="System.Console" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Northwind.DataContext\Northwind.DataContext.csproj" />
    <ProjectReference Include="..\Northwind.Fulfillment\Northwind.Fulfillment.csproj" />
  </ItemGroup>

</Project>
